{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Silverpoint",
  "version": "0.14.0",
  "identifier": "com.dayle22.silverpoint",
  "build": {
    "beforeDevCommand": "bun scripts/build-windows-sidecars.ts && bun run generate:tauri-menu && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun scripts/build-windows-sidecars.ts && bun run generate:tauri-menu && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Silverpoint",
        "width": 1280,
        "height": 800,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --ignore-gpu-blocklist --enable-gpu-rasterization --enable-zero-copy"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/silverpoint-mcp"],
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["pen"],
        "name": "Silverpoint Design File",
        "description": "Silverpoint design file",
        "role": "Editor",
        "mimeType": "application/x-pencil-pen",
        "rank": "Alternate"
      },
      {
        "ext": ["fig"],
        "name": "Figma Design File",
        "description": "Figma design file",
        "role": "Editor",
        "mimeType": "application/x-figma",
        "rank": "Alternate"
      }
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: Danila Poyarkov (N7D7M3Q3CD)"
    }
  },
  "plugins": {}
}
