{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openpencil-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_EMAIL_DOMAIN": "biosculpture.com",
    "ACCESS_TEAM_DOMAIN": "cold-union-96f0.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "REPLACE_WITH_ACCESS_AUDIENCE_TAG"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openpencil-biosculpture-db",
      "database_id": "35f1c718-e5ec-485e-abf5-eafb3a942030",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PROJECT_ROOM",
        "class_name": "ProjectRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ProjectRoom"]
    }
  ]
}
